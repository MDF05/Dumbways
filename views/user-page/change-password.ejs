<%- contentFor("linkCss") %>
<script>
    setTimeout(() => document.querySelector(".alert").classList.add("d-none"), 4000)
</script>

<%- contentFor("body")  %>
<% if(messages?.danger) { %>
<div class="alert alert-danger alert-dismissible fade show position-fixed w-100 top-0" role="alert"
    style="z-index: 10000;">
    <%messages.danger.forEach(msg => { %>
    <%= msg %>
    <% })  %>
    <button type=" button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
<% } %>


<% if(messages?.succes) { %>
<div class="alert alert-success alert-dismissible fade show position-fixed w-100 top-0" role="alert"
    style="z-index: 10000;">
    <%messages.succes.forEach(msg => { %>
    <%= msg %>
    <% })  %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
<%  }%>


<div class="container d-flex min-vh-100 justify-content-center align-items-center">
    <form action="/user/change-password" method="post" class="form-container form-control w-50 shadow ">
        <div class="d-flex justify-content-center">
            <h1>change password</h1>
        </div>
        <div class="d-flex flex-column mb-2 gap-2">
            <label for="oldPassword">old password </label>
            <input type="password" id="oldPassword" name="oldPassword">
        </div>
        <div class="d-flex flex-column mb-2 gap-2">
            <label for="newPassword">new password </label>
            <input type="password" id="newPassword" name="newPassword">
        </div>
        <div class="d-flex mt-5 justify-content-between pe-2">
            <input type="submit" value="change password" class="btn  btn-dark btn-outline-success text-white">
        </div>
    </form>
</div>


