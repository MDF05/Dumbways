<%- contentFor("linkCss") %>
<script>
    setTimeout(() => document.querySelector(".alert").classList.add("d-none"), 4000)
</script>

<%- contentFor("body")  %>
<% if(messages?.danger) { %>
<div class="alert alert-danger alert-dismissible fade show position-fixed w-100 top-0" role="alert"
    style="z-index: 10000;">
    <%messages.danger.forEach(msg => { %>
    <%= msg %>
    <% })  %>
    <button type=" button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
<% } %>


<% if(messages?.succes) { %>
<div class="alert alert-success alert-dismissible fade show position-fixed w-100 top-0" role="alert"
    style="z-index: 10000;">
    <%messages.succes.forEach(msg => { %>
    <%= msg %>
    <% })  %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
<%  }%>

<div class="container d-flex min-vh-100 justify-content-center align-items-center mt-5">
    <form action="/user/register" method="post" enctype="multipart/form-data"
        class="form-container form-control w-50 shadow ">
        <div class="d-flex justify-content-center">
            <h1>Register</h1>
        </div>
        <div class="d-flex flex-column mb-2 gap-2">
            <label for="name">name </label>
            <input type="text" id="name" name="name">
        </div>
        <div class="d-flex flex-column mb-2 gap-2">
            <label for="email">email </label>
            <input type="email" id="email" name="email">
        </div>
        <div class="d-flex flex-column mb-2 gap-2">
            <label for="password">password </label>
            <input type="password" id="password" name="password">
        </div>
        <div class="d-flex flex-column mb-2 gap-2">
            <label for="image">image </label>
            <input type="file" id="image" class="bg-white border border-black" name="image">
        </div>
        <div class="d-flex mt-5 justify-content-between pe-2">
            <a href="/user/login" class="link-info">sudah punya akun login disini !</a>
            <input type="submit" value="submit" class="btn  btn-dark btn-outline-success text-white">
        </div>
    </form>
</div>


<%- contentFor("linkJs") %>