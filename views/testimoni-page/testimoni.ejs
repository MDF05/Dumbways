<!-- @format -->
<%- contentFor("linkCss") %>
<link rel="stylesheet" href="/assets/css/testimoni.css" />
<script>
    setTimeout(() => document.querySelector(".alert").classList.add("d-none"), 4000)
</script>

<%- contentFor("body")  %>
<% if(messages?.danger) { %>
<div class="alert alert-danger alert-dismissible fade show position-fixed w-100 top-0" role="alert"
    style="z-index: 10000;">
    <%messages.danger.forEach(msg => { %>
    <%= msg %>
    <% })  %>
    <button type=" button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
<% } %>


<% if(messages?.succes) { %>
<div class="alert alert-success alert-dismissible fade show position-fixed w-100 top-0" role="alert"
    style="z-index: 10000;">
    <%messages.succes.forEach(msg => { %>
    <%= msg %>
    <% })  %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
<%  }%>
<div class="container-testimoni">
    <div class="container-form-testimoni">
        <form action="/testimoni" method="post" enctype="multipart/form-data">
            <div class="add-testimoni-container">
                <h1 class="add-testimoni-title">Add Testimoni</h1>
            </div>
            <div>
                <label for="name">name</label>
                <input type="text" name="name" id="name" />
            </div>
            <div>
                <label for="deskripsi">deskripsi</label>
                <textarea type="text" name="deskripsi" id="deskripsi"> </textarea>
            </div>
            <div>
                <label for="input-file">upload gambar </label>
                <input type="file" name="inputImage" id="inputImage" />
                <img src="" alt="preview-image" class="preview-image shadow mt-2 border" style="height: 170px;">
            </div>
            <div class="container-rating">
                <div>
                    <h4>berikan rating</h4>
                </div>
                <div class="list-rating">
                    <div class="div-star">
                        <label for="star-1">
                            <img src="https://img.icons8.com/?size=100&id=8ggStxqyboK5&format=png&color=000000"
                                alt="baru" class="star" />
                        </label>
                        <input type="radio" name="star" id="star-1" hidden class="star-count" star="1" value="1" />
                    </div>
                    <div class="div-star">
                        <label for="star-2">
                            <img src="https://img.icons8.com/?size=100&id=8ggStxqyboK5&format=png&color=000000"
                                alt="baru" class="star" />
                        </label>
                        <input type="radio" name="star" id="star-2" hidden class="star-count" star="2" value="2" />
                    </div>
                    <div class="div-star">
                        <label for="star-3">
                            <img src="https://img.icons8.com/?size=100&id=8ggStxqyboK5&format=png&color=000000"
                                alt="baru" class="star" />
                        </label>
                        <input type="radio" name="star" id="star-3" hidden class="star-count" star="3" value="3" />
                    </div>
                    <div class="div-star">
                        <label for="star-4">
                            <img src="https://img.icons8.com/?size=100&id=8ggStxqyboK5&format=png&color=000000"
                                alt="baru" class="star" />
                        </label>
                        <input type="radio" name="star" id="star-4" class="star-count" hidden star="4" value="4" />
                    </div>
                    <div class="div-star">
                        <label for="star-5">
                            <img src="https://img.icons8.com/?size=100&id=8ggStxqyboK5&format=png&color=000000"
                                alt="baru" class="star" />
                        </label>
                        <input type="radio" name="star" id="star-5" hidden class="star-count" star="5" value="5" />
                    </div>
                </div>
            </div>
            <div class="submit-container">
                <input type="submit" value="submit" class="add-testimoni" />
            </div>
        </form>
    </div>
</div>

<div class="container-list-rating">
    <div class="judul-testimoni">
        <h1>list Testimoni</h1>
    </div>
    <div class="container-rating-star">
        <h2>Rating By Star</h2>
        <div class="rating-star" star="<%= filterStar? filterStar : "0" %>">
            <span class="list-star">
                <span><input type="radio" class="filter-star" id="star-rating-1" value="1" name="filter-star-rating" />
                    <label class="label-reset" for="star-rating-1"><img
                            src="https://img.icons8.com/?size=100&id=8ggStxqyboK5&format=png&color=000000"
                            alt="filter-rating-by-star" class="filter-star-rating" /></label></span><span><input
                        type="radio" class="filter-star" id="star-rating-2" value="2" name="filter-star-rating" /><label
                        class="label-reset" for="star-rating-2"><img
                            src="https://img.icons8.com/?size=100&id=8ggStxqyboK5&format=png&color=000000"
                            alt="filter-rating-by-star" class="filter-star-rating" /></label></span><span><input
                        type="radio" class="filter-star" id="star-rating-3" value="3" name="filter-star-rating" /><label
                        class="label-reset" for="star-rating-3"><img
                            src="https://img.icons8.com/?size=100&id=8ggStxqyboK5&format=png&color=000000"
                            alt="filter-rating-by-star" class="filter-star-rating" /></label></span><span><input
                        type="radio" class="filter-star" id="star-rating-4" value="4" name="filter-star-rating" /><label
                        class="label-reset" for="star-rating-4"><img
                            src="https://img.icons8.com/?size=100&id=8ggStxqyboK5&format=png&color=000000"
                            alt="filter-rating-by-star" class="filter-star-rating" /></label></span><span><input
                        type="radio" class="filter-star" id="star-rating-5" value="5" name="filter-star-rating" /><label
                        class="label-reset" for="star-rating-5"><img
                            src="https://img.icons8.com/?size=100&id=8ggStxqyboK5&format=png&color=000000"
                            alt="filter-rating-by-star" class="filter-star-rating" /></label></span>
            </span>
            <span class="all-star">
                <label for="reset-rating">All Rating</label>
                <input type="radio" name="filter-star-rating" value="0" id="reset-rating" />
            </span>
        </div>
    </div>
    <div class="list-testimoni">
        <% Testimoni.forEach((testimoni,index) => { %>
        <div class="testimoni">
            <div class="header">
                <img src="/<%= testimoni.imageUrl  %>" alt="" />
            </div>
            <div class="body">
                <div>
                    <p class="description">"<%= testimoni.deskripsi %>"</p>
                    <h4 class="judul"><%= testimoni.name %></h4>
                </div>
                <div class="rating-star">
                    <span class="teks-star"><%= testimoni.star %> </span>
                    <span class="container-rating-card">
                        <span class="span-star">
                            <%- cardStarColor(testimoni.star) %>
                        </span>
                    </span>
                </div>
            </div>
            <div class="footer">
                <% convertDate = datePostConvert(testimoni.createAt) %>
                <% postAge = agePost(testimoni.createAt) %>
                <div class="post-date">post : <%= convertDate  %> </div>
                <div class="age-post"><%= postAge  %></div>
                <div class="navigasi-testimoni" id=${testimoni._id} index=${index}>
                    <form action="/testimoni/<%= testimoni._id %>?_method=DELETE" method="post">
                        <button class="delete-testimoni"
                            onclick="return confirm('are you sure to delete this testimoni')">delete</button>
                    </form>
                    <button>
                        <a class="update-testimoni" href="/testimoni/update/<%= testimoni._id %>">edit</a>
                    </button>
                </div>
            </div>
        </div>
        <% } )  %>
    </div>
</div>

<%- contentFor("linkJs") %>

<!-- <script src="/assets/js/OOP-listTestimonial.js"></script> -->

<script src="/assets/js/testimoni.js"></script>
<script>
    const previewImage = document.querySelector(".preview-image")
    const inputImage = document.querySelector("#inputImage")

    inputImage.addEventListener("change", (event) => {
        const files = URL.createObjectURL(inputImage.files[0])
        previewImage.src = files
    })
</script>