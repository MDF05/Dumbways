<!-- @format -->
<%- contentFor("linkCss") %>
<link rel="stylesheet" href="/assets/css/testimoni.css" />
<script>
    setTimeout(() => document.querySelector(".alert").classList.add("d-none"), 4000)
</script>

<%- contentFor("body")  %>
<% if(messages?.danger) { %>
<div class="alert alert-danger alert-dismissible fade show position-fixed w-100 top-0" role="alert"
    style="z-index: 10000;">
    <%messages.danger.forEach(msg => { %>
    <%= msg %>
    <% })  %>
    <button type=" button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
<% } %>


<% if(messages?.succes) { %>
<div class="alert alert-success alert-dismissible fade show position-fixed w-100 top-0" role="alert"
    style="z-index: 10000;">
    <%messages.succes.forEach(msg => { %>
    <%= msg %>
    <% })  %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
<%  }%>
<div class="container-testimoni">
    <div class="container-form-testimoni">
        <form action="/testimoni/<%= Testimoni._id  %>?_method=PUT" method="post" enctype="multipart/form-data">
            <div class="add-testimoni-container">
                <h1 class="add-testimoni-title">Add Testimoni</h1>
            </div>
            <div>
                <label for="name">name</label>
                <input type="text" name="name" id="name" value="<%= Testimoni.name  %>" />
            </div>
            <div>
                <label for="deskripsi">deskripsi</label>
                <textarea type="text" name="deskripsi" id="deskripsi"><%= Testimoni.deskripsi  %> </textarea>
            </div>
            <div>
                <label for="input-file">upload gambar </label>
                <input type="file" name="inputImage" id="inputImage" />
                <img src="/<%= Testimoni.imageUrl  %>" alt="preview-image" class="w-50 mt-2 testimoni-image">
            </div>
            <div class="container-rating">
                <div>
                    <h4>berikan rating</h4>
                </div>
                <div class="list-rating" star="<%= Testimoni.star  %>">
                    <div class="div-star">
                        <label for="star-1">
                            <img src="https://img.icons8.com/?size=100&id=8ggStxqyboK5&format=png&color=000000"
                                alt="baru" class="star" />
                        </label>
                        <input type="radio" name="star" id="star-1" hidden class="star-count" star="1" value="1" />
                    </div>
                    <div class="div-star">
                        <label for="star-2">
                            <img src="https://img.icons8.com/?size=100&id=8ggStxqyboK5&format=png&color=000000"
                                alt="baru" class="star" />
                        </label>
                        <input type="radio" name="star" id="star-2" hidden class="star-count" star="2" value="2" />
                    </div>
                    <div class="div-star">
                        <label for="star-3">
                            <img src="https://img.icons8.com/?size=100&id=8ggStxqyboK5&format=png&color=000000"
                                alt="baru" class="star" />
                        </label>
                        <input type="radio" name="star" id="star-3" hidden class="star-count" star="3" value="3" />
                    </div>
                    <div class="div-star">
                        <label for="star-4">
                            <img src="https://img.icons8.com/?size=100&id=8ggStxqyboK5&format=png&color=000000"
                                alt="baru" class="star" />
                        </label>
                        <input type="radio" name="star" id="star-4" class="star-count" hidden star="4" value="4" />
                    </div>
                    <div class="div-star">
                        <label for="star-5">
                            <img src="https://img.icons8.com/?size=100&id=8ggStxqyboK5&format=png&color=000000"
                                alt="baru" class="star" />
                        </label>
                        <input type="radio" name="star" id="star-5" hidden class="star-count" star="5" value="5" />
                    </div>
                </div>
            </div>
            <div class="submit-container">
                <input type="submit" value="submit" class="add-testimoni" />
            </div>
        </form>
    </div>
</div>


<%- contentFor("linkJs") %>
<script src="/assets/js/testimoni.js"></script>
<script src="/assets/js/edit-testimoni.js"></script>
<script>
    const updateInput = document.querySelector("#inputImage")
    const userImage = document.querySelector(".testimoni-image")
    fileInput(userImage.src)

    updateInput.addEventListener("change", (event) => {
        const newImage = URL.createObjectURL(updateInput.files[0])
        userImage.src = newImage

    })

    function fileInput(srcImg) {
        fetch(srcImg).then(response => response.blob()).then(response => {
            let sourceImage = srcImg.split("/")
            sourceImage = sourceImage[sourceImage.length - 1]

            sourceImage = sourceImage.replaceAll("%20", " ")

            let file = new File([response], sourceImage, {
                type: "image/jpeg",
                lastModified: new Date().getTime()
            }, 'utf-8');
            let container = new DataTransfer();
            container.items.add(file);
            updateInput.files = container.files;
        })
    }
</script>